project('QVideoBrowser','cpp', default_options : ['cpp_std=c++20','b_lto=true'])
qt6 = import('qt6')
qt6_dep = dependency('qt6', modules: ['Core', 'Widgets','Gui'])
magickdep = dependency('Magick++-7.Q8')
threaddep = dependency('threads')
boostdep = dependency('boost', modules : ['timer'])	
add_global_arguments('-fPIC', language : 'cpp' )
executable('qvbrowser',['QVBrowser.cpp','DbConnector.cpp','QVDec.cpp','VideoUtils.cpp','qmain.cpp'], dependencies : [qt6_dep,magickdep,threaddep,boostdep], link_args: ['-L/usr/lib/','-lavutil','-lswscale','-lavcodec','-lavformat','-lsqlite3','-lfftw3f','-lzstd','-lpng','-ldlib'])
